# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Generated USD scenes (only written when run_sim.py --save is requested)
assets/rebuilt_*.usda
*.usdc

# Generated RL env templates (rebuild with scripts/rl/export_env_template.py)
assets/rl/

# Logs, screenshots, and other rebuildable run artifacts
*.log
*.png
*.jpg
*.jpeg
*.gif
*.mp4
artifacts/

