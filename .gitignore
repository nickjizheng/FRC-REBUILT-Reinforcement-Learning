# Compiled launcher (rebuilt from tools/LaunchSimulator.cs)
*.exe

# RL checkpoints / training outputs
*.ckpt
*.pth
*.pt
checkpoints/
runs/**/checkpoints/
logs/
wandb/

# Local experiment output and machine-specific recovery material
runs/**
server_backup_*/
setup_render_env.sh.frombackup
*.bak
*.bak_*
*.frombackup
~$*

# Private working notes, dated experiment records, and local tool state
docs/*_BRIEF_*.md
docs/*_SPEC.md
docs/STAGE*.md
*_review/
/.??*
!/.gitignore
!/.github/
!/.github/**

